{
  "manifest_version": 3,
  "name": "ScrollShot · 连续滚动截图",
  "version": "1.0.6",
  "description": "Capture a webpage from top to bottom as sequential, non-overlapping PNG images in a title-based folder.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "ScrollShot · Continuous screenshots",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
